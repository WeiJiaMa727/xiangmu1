{
  "name": "qiuzhao-mail-helper-pro2",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "小马快跑秋招版邮箱 Pro - 邮件整理 + 企业投递资源库 + 求职进度管理",
  "scripts": {
    "start": "node --max-old-space-size=192 server/index.mjs",
    "serve": "node --max-old-space-size=192 server/index.mjs",
    "dev": "concurrently -n web,proxy -c magenta,cyan \"npm:dev:web\" \"npm:dev:proxy\"",
    "dev:web": "vite",
    "dev:proxy": "node --max-old-space-size=192 server/index.mjs",
    "dev:frontend-only": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node --max-old-space-size=192 scripts/verify.mjs",
    "verify:library": "node --max-old-space-size=192 scripts/verify-library.mjs",
    "verify:v3": "node --max-old-space-size=192 scripts/verify-v3.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "concurrently": "^9.2.5",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "imapflow": "^1.7.8",
    "lucide-react": "^0.454.0",
    "mailparser": "^3.9.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
